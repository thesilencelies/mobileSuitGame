{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "generate cards",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/generateCards.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "postDebugTask": "create all",
    },
    {
      "name": "generate TTS images - terrain",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/generate_card_sheet.py",
      "args": [
        "--csv=decks/terrain_deck.csv",
        "--output=build/terrain_image.tex",
        "--cols=6",
        "--rows=6",
        "--back_text=Terrain",
        "--back_color=green"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "postDebugTask": "create tts terrain",
    },
    {
      "name": "generate TTS images - frames",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/generate_card_sheet.py",
      "args": [
        "--csv=decks/frames_deck.csv",
        "--output=build/frames_image.tex",
        "--cols=6",
        "--rows=3",
        "--back_text=Frame",
        "--back_color=red"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "postDebugTask": "create tts frames",
    },
    {
      "name": "generate TTS images - deck",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/generate_card_sheet.py",
      "args": [
        "--csv=decks/${config:deck.prefix}.csv",
        "--output=build/${config:deck.prefix}_image.tex",
        "--add-back",
        "--cols=7",
        "--rows=4"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "postDebugTask": "create tts deck",
    },
    {
      "name": "generate TTS images - deck backs",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/generate_card_sheet.py",
      "args": [
        "--csv=decks/${config:deck.prefix}_backs.csv",
        "--output=build/${config:deck.prefix}_image.tex",
        "--repeat",
        "--add-back",
        "--cols=7",
        "--rows=4"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "postDebugTask": "create tts deck backs",
    },
    {
      "name": "plot statistics",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/plotCardStatistics.py",
      "console": "integratedTerminal",
      "args": [
        // "--melee",
        // "--ranged",
        "--no-booster",
        "--no-basic"
      ]
    }
  ],
  "compounds": [
    {
      "name": "create deck",
      "configurations": [
        "generate TTS images - deck",
        "generate TTS images - deck backs"
      ]
    }
  ]
}