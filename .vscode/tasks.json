{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "create cards",
      "command": "pdflatex",
      "type": "shell",
      "args": [
        "card_all.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "group": "build"
    },
    {
      "label": "create rules",
      "command": "pdflatex",
      "type": "shell",
      "args": [
        "rules.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/rules"
      },
      "group": "build"
    },
    {
      "label": "create tts terrain pdf",
      "command": "pdflatex",
      "type": "shell",
      "args": [
        "terrain_image.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "group": "build"
    },
    {
      "label": "create tts terrain",
      "command": "convert",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "args": [
        "-density",
        "150",
        "terrain_image.pdf",
        "-compress",
        "lzw",
        "terrain_image.png"
      ],
      "dependsOn": [
        "create tts terrain pdf"
      ],
      "group": "build"
    },
    {
      "label": "create tts frames pdf",
      "command": "pdflatex",
      "type": "shell",
      "args": [
        "frames_image.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "group": "build"
    },
    {
      "label": "create tts frames image",
      "command": "convert",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "args": [
        "-density",
        "150",
        "frames_image.pdf",
        "-compress",
        "lzw",
        "frames_image.png"
      ],
      "dependsOn": [
        "create tts frames pdf"
      ],
      "group": "build"
    },
    {
      "label": "create tts frames",
      "command": "cp",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "build/frames_image.png",
        "TTSImages/frames_image.png",
      ],
      "dependsOn": [
        "create tts frames image"
      ],
      "group": "build"
    },
    {
      "label": "create tts deck pdf",
      "command": "pdflatex",
      "type": "shell",
      "args": [
        "${config:deck.prefix}_image.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "group": "build"
    },
    {
      "label": "create tts deck",
      "command": "convert",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "args": [
        "-density",
        "150",
        "${config:deck.prefix}_image.pdf",
        "-compress",
        "lzw",
        "${config:deck.prefix}_image.png"
      ],
      "dependsOn": [
        "create tts deck pdf"
      ],
      "group": "build"
    },
    {
      "label": "create tts deck back pdf",
      "command": "pdflatex",
      "type": "shell",
      "args": [
        "${config:deck.prefix}_back_image.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "group": "build"
    },
    {
      "label": "create tts deck back",
      "command": "convert",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "args": [
        "-density",
        "150",
        "${config:deck.prefix}_back_image.pdf",
        "-compress",
        "lzw",
        "${config:deck.prefix}_back_image.png"
      ],
      "dependsOn": [
        "create tts deck back pdf"
      ],
      "group": "build"
    },
    {
      "label": "upload rules",
      "command": "python3",
      "type": "shell",
      "args": [
        "upload_rules.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build"
    },
    {
      "label": "create and publish rules",
      "type": "shell",
      "command": "echo published",
      "dependsOrder": "sequence",
      "dependsOn": [
        "create rules",
        "upload rules"
      ],
      "group": "build"
    },
    {
      "label": "create all",
      "type": "shell",
      "command": "echo created",
      "dependsOn": [
        "create rules",
        "create cards"
      ]
    },
    {
      "label": "generate all card images",
      "command": "python3",
      "type": "shell",
      "args": [
        "generate_card_images.py",
        "--all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build"
    },
    {
      "label": "create playtest card bundle",
      "command": "python3",
      "type": "shell",
      "args": [
        "-m",
        "playtest.server.images",
        "--force"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build"
    },
    {
      "label": "create playtest board assets",
      "command": "python3",
      "type": "shell",
      "args": [
        "-m",
        "playtest.server.assets",
        "--force"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build"
    },
    {
      "label": "create playtest assets",
      "type": "shell",
      "command": "echo playtest assets created",
      "dependsOrder": "sequence",
      "dependsOn": [
        "generate all card images",
        "create playtest card bundle",
        "create playtest board assets"
      ],
      "group": "build"
    }
  ]
}