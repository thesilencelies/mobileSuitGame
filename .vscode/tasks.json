{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "create cards",
      "command": "pdflatex",
      "type": "shell",
      "args": [
        "card_all.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "group": "build"
    },
    {
      "label": "create rules",
      "command": "pdflatex",
      "type": "shell",
      "args": [
        "rules.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/rules"
      },
      "group": "build"
    },
    {
      "label": "create tts terrain pdf",
      "command": "pdflatex",
      "type": "shell",
      "args": [
        "terrain_image.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "group": "build"
    },
    {
      "label": "create tts terrain",
      "command": "convert",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "args": [
        "-density",
        "150",
        "terrain_image.pdf",
        "-compress",
        "lzw",
        "terrain_image.png"
      ],
      "dependsOn": [
        "create tts terrain pdf"
      ],
      "group": "build"
    },
    {
      "label": "create tts frames pdf",
      "command": "pdflatex",
      "type": "shell",
      "args": [
        "frames_image.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "group": "build"
    },
    {
      "label": "create tts frames",
      "command": "convert",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "args": [
        "-density",
        "150",
        "frames_image.pdf",
        "-compress",
        "lzw",
        "frames_image.png"
      ],
      "dependsOn": [
        "create tts frames pdf"
      ],
      "group": "build"
    },
    {
      "label": "create tts deck pdf",
      "command": "pdflatex",
      "type": "shell",
      "args": [
        "${config:deck.prefix}_image.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "group": "build"
    },
    {
      "label": "create tts deck",
      "command": "convert",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "args": [
        "-density",
        "150",
        "${config:deck.prefix}_image.pdf",
        "-compress",
        "lzw",
        "${config:deck.prefix}_image.png"
      ],
      "dependsOn": [
        "create tts deck pdf"
      ],
      "group": "build"
    },
    {
      "label": "create all",
      "type": "shell",
      "command": "echo created",
      "dependsOn": [
        "create rules",
        "create cards"
      ]
    }
  ]
}